OPENAI_API_KEY=
GROQ_API_KEY=
POCKET_TTS_CONFIG_PATH=voices/pocket-tts/portuguese.yaml
POCKET_TTS_VOICE_PATH=voices/pocket-tts/george.safetensors
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=my-collection

DATABASE_URL=

# Pasta local de PDFs; a URL remota é opcional e só deve ser usada no ambiente local.
DOCUMENT_STORAGE_DIR=downloads
# API de produção: https://api.seu-dominio (ou https://seu-dominio/api se usar o proxy Next)
# O servidor precisa disponibilizar GET /documents/{id}/content.
# Deixe vazio em produção. Usa a sessão atual para documentos restritos.
DOCUMENT_REMOTE_BASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAG_TOP_K=8
RAG_CANDIDATE_COUNT=32
RAG_RERANKER_MODEL=gpt-4.1-nano
CHAT_HISTORY_LIMIT=12

# Autenticação e envio de mensagens (somente no back-end)
AUTH_SECRET=
APP_PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true
